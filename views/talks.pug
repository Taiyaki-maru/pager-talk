extends layout

block content
  .pager-card.p-3.mb-3
    .d-flex.justify-content-between.align-items-center.mb-3
      span.fw-bold= `LOGIN: ${user.displayName}`
      form(action="/logout", method="POST", style="margin: 0;")
        button.btn.btn-sm.btn-pager-outline(type="submit") [ ログアウト ]
    hr.my-2
    .list-group.list-group-flush#talks-list
      .text-center.py-3 読み込み中...

  .d-flex.gap-2
    a.btn.btn-pager.w-50(href="/talks") [ トーク ]
    a.btn.btn-pager-outline.w-50(href="/dictionary") [ マイ辞書 ]

block scripts
  script(src="/js/talks.js")