extends layout

block content
  .pager-card.p-3.mb-3
    .d-flex.justify-content-between.align-items-center.mb-3
      span.fw-bold [ マイ辞書リスト ]
      button.btn.btn-sm.btn-pager(type="button", data-bs-toggle="modal", data-bs-target="#addDictModal") [ + 追加 ]
    hr.my-2
    .list-group.list-group-flush#dictionary-list
      .text-center.py-3 読み込み中...

  .d-flex.gap-2
    a.btn.btn-pager-outline.w-50(href="/talks") [ トーク ]
    a.btn.btn-pager.w-50(href="/dictionary") [ マイ辞書 ]

  // 辞書追加モーダル
  .modal.fade#addDictModal(tabindex="-1")
    .modal-dialog.modal-dialog-centered
      .modal-content.pager-card
        .modal-header
          h5.modal-title.h6 [ 辞書項目の追加 ]
          button.btn-close(type="button", data-bs-dismiss="modal")
        .modal-body
          .mb-3
            label.form-label.small 数字コード (1〜16桁)
            input.form-control.rounded-0#new-code(type="text", placeholder="0840", maxlength="16")
          .mb-3
            label.form-label.small 意味
            input.form-control.rounded-0#new-label(type="text", placeholder="おはよう")
          button.btn.btn-pager.w-100(onclick="addDictionary()") [ 保存 ]

block scripts
  script(src="/js/dictionary.js")